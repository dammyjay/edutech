<h1>👨‍🏫 Teacher Dashboard</h1>

<!-- ✅ Profile / Greeting -->
<div class="profile-box">
  <img src="<%= profile.profile_picture || '/images/default-avatar.png' %>" 
       alt="Profile" class="profile-pic">
  <div>
    <h2>Welcome, <%= profile.fullname %> 👋</h2>
    <p><%= profile.email %></p>
    <p><%= new Date().toLocaleDateString() %></p>
  </div>
</div>

<!-- ✅ Key Stats -->
<div class="cards">
  <div class="card">👥 Students <h3><%= keyStats.total_students || 0 %></h3></div>
  <div class="card">🏫 Classes <h3><%= keyStats.total_classes || 0 %></h3></div>
  <div class="card">📖 Lessons <h3><%= keyStats.lessons_completed || 0 %>/<%= keyStats.total_lessons || 0 %></h3></div>
  <div class="card">📝 Avg Quiz <h3><%= keyStats.avg_quiz_score || "N/A" %></h3></div>
  <div class="card">📑 Avg Assignment <h3><%= keyStats.avg_assignment_score || "N/A" %></h3></div>
  <div class="card">⏳ Engagement <h3><%= keyStats.engagement_last7 || 0 %>%</h3></div>

</div>

<!-- ✅ Class Overview -->
<h2>📚 Classes</h2>
<div class="cards">
  <% classStats.forEach(c => { %>
    <div class="card">
      <h3><%= c.class_name %></h3>
      <p>👥 Students: <%= c.students %></p>
      <p>📖 Lessons: <%= c.lessons_completed %> / <%= c.total_lessons %> 
         (<%= c.total_lessons ? Math.round((c.lessons_completed / c.total_lessons) * 100) : 0 %>%)</p>
      <p>📝 Avg Quiz: <%= c.avg_quiz_score || "N/A" %></p>
      <p>📑 Avg Assignment: <%= c.avg_assignment_score || "N/A" %></p>
      <p>⏳ Engagement: <%= c.engagement || 0 %>%</p>
      <a class="btn-view" href="/teacher/classroom/<%= c.id %>/students">View Students</a>
    </div>
  <% }) %>
</div>

<!-- ✅ Charts -->
<h2>📈 Class Progress</h2>
<canvas id="lessonChart"></canvas>
<canvas id="quizChart"></canvas>

<!-- ✅ Student Snapshots -->
<h2>👨‍🎓 Top Students</h2>
<div class="user-table-wrapper">
  <table class="user-table">
    <thead>
      <tr>
        <th>Student</th>
        <th>Average Quiz</th>
      </tr>
    </thead>
    <tbody>
      <% topStudents.forEach(s => { %>
        <tr>
          <td><%= s.fullname %></td>
          <td><%= s.avg_score || "N/A" %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<h2>⚠️ Struggling Students</h2>
<div class="user-table-wrapper">
  <table class="user-table">
    <thead>
      <tr>
        <th>Student</th>
        <th>Lessons Done</th>
      </tr>
    </thead>
    <tbody>
      <% strugglingStudents.forEach(s => { %>
        <tr>
          <td><%= s.fullname %></td>
          <td><%= s.lessons_done || 0 %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>


<!-- ✅ Notifications -->
<h2>📬 Notifications</h2>
<p>Pending Assignments to Grade: <%= pendingAssignments %></p>

