                <form onsubmit="assignUsers(event, '<%= c.id %>', 'student')">
                  <select id="studentMultiSelect-<%= c.id %>" multiple style="width:100%; height:120px;">
                    <% school.students.forEach(stu => { if (!stu.classroom_id) { %>
                      <!-- <option value="<%= stu.id %>"><%= stu.fullname %> (<%= stu.email %>)</option> -->
