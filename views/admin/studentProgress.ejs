<div id="lessons" class="tab-content">
  <h2>📚 Lessons Progress</h2>
  <% if (courses.length) { %>
    <table>
      <thead>
        <tr><th>Lesson</th><th>Module</th><th>Course</th><th>Status</th><th>Completed At</th></tr>
      </thead>
      <tbody>
        <% courses.forEach(c => { %>
          <% c.modules.forEach(m => { %>
            <% m.lessons.forEach(l => { %>
              <tr>
                <td><%= l.lesson_title %></td>
                <td><%= m.module_title %></td>
                <td><%= c.course_title %></td>
                <td><%= l.completed_at ? "✅ Completed" : "❌ Not completed" %></td>
                <td><%= l.completed_at ? new Date(l.completed_at).toLocaleString() : "-" %></td>
              </tr>
            <% }) %>
          <% }) %>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p>No lessons available yet.</p>
  <% } %>
</div>


