      </thead>
      <tbody>
        <% courses.forEach(c => { %>
          <% c.modules.forEach(m => { %>
            <tr>
              <td><%= m.module_title %></td>
              <td><%= c.course_title %></td>
              <td><%= m.percent %>%</td>
              <td><%= m.quizAvg ?? "N/A" %></td>
              <td><%= m.assignmentAvg ?? "N/A" %></td>
            </tr>
          <% }) %>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p>No modules unlocked yet.</p>
  <% } %>
</div>


